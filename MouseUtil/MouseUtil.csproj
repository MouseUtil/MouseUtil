<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>MouseUtil</RootNamespace>
    <AssemblyName>MouseUtil</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="'$(Configuration)'=='Debug'">Assets\debug.ico</ApplicationIcon>
    <ApplicationIcon Condition="'$(Configuration)'=='Release'">Assets\app.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>

    <!-- Unpackaged, self-contained deployment: no MSIX, no Store install, no Package.appxmanifest.
         Output is a plain folder with MouseUtil.exe you can run or zip up directly. -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>

    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Kept in sync with installer\MouseUtil.iss's MyAppVersion - shown in the Settings flyout
         header (see MainWindow.xaml's SettingsFlyout) via Package.Current-less reflection on the
         running assembly, since this app is unpackaged and has no Package.appxmanifest. -->
    <Version>1.1.2</Version>
  </PropertyGroup>

  <PropertyGroup>
    <DebugType>embedded</DebugType>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
  </ItemGroup>

</Project>
