<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>MouseUtil</RootNamespace>
    <AssemblyName>MouseUtil</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="'$(Configuration)'=='Debug'">Assets\debug.ico</ApplicationIcon>
    <ApplicationIcon Condition="'$(Configuration)'=='Release'">Assets\app.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>

    <!-- Packaged (MSIX) deployment, for Microsoft Store submission. -->
    <WindowsPackageType>MSIX</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>

    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Kept in sync with .installer-inno\MouseUtil.iss's MyAppVersion and Package.appxmanifest's Identity
         Version - shown in the Settings overlay header (see MainWindow.xaml's SettingsVersionText)
         via reflection on the running assembly (MainWindow.GetCurrentVersionString). -->
    <Version>2.0.1</Version>

    <Authors>MouseUtil</Authors>
    <Company>MouseUtil</Company>

    <!-- Keeps MSIX packaging output out of the repo root, alongside bin/obj - see Directory.Build.props.
         PlatformSpecificUploadBundleArtifactsListDir must be set too, or a StoreUpload build
         (UapAppxPackageBuildMode=StoreUpload) writes its Upload\ manifest list back to the repo
         root instead of following PlatformSpecificBundleArtifactsListDir below. -->
    <AppxPackageDir>$(MSBuildProjectDirectory)\.output\AppPackages\</AppxPackageDir>
    <PlatformSpecificBundleArtifactsListDir>$(MSBuildProjectDirectory)\.output\BundleArtifacts\</PlatformSpecificBundleArtifactsListDir>
    <PlatformSpecificUploadBundleArtifactsListDir>$(MSBuildProjectDirectory)\.output\BundleArtifacts\Upload\</PlatformSpecificUploadBundleArtifactsListDir>
  </PropertyGroup>

  <PropertyGroup>
    <DebugType>embedded</DebugType>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- The SDK auto-detects the .git folder and sets SourceRevisionId to the full 40-character commit
       SHA, then appends it to AssemblyInformationalVersion (what MainWindow.GetCurrentVersionString/
       ProductVersion reads) as "+<SourceRevisionId>" - shortened here to git's own conventional 7-character short-SHA
       length for Debug builds, so Settings shows e.g. "1.3.0+7b2b7ba" instead of the full hash. Must
       run after InitializeSourceControlInformation (the SDK target that actually sets SourceRevisionId
       from git) - overriding it any earlier would just get overwritten by that target's own default. -->
  <Target Name="ShortenSourceRevisionId" AfterTargets="InitializeSourceControlInformation" Condition="'$(Configuration)'=='Debug'">
    <PropertyGroup>
      <SourceRevisionId>$(SourceRevisionId.Substring(0, 7))</SourceRevisionId>
    </PropertyGroup>
  </Target>

  <!-- Release builds show a plain version number ("1.3.0"), with no commit suffix at all - unlike
       Debug builds (see ShortenSourceRevisionId above), which keep the short SHA since knowing exactly
       which commit a dev build came from is useful there. This disables the SDK's append step
       entirely for Release, rather than shortening SourceRevisionId to an empty string, which would
       otherwise leave a bare trailing "+" on the version. -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- README-only asset (GitHub renders it there) - the WinUI SDK's Microsoft.WinUI.props globs the
       entire Assets folder as Content and copies it to the build output otherwise, which would add
       this file's ~4.6MB to the built app for no reason since nothing in the app references it. -->
  <ItemGroup>
    <Content Remove="Assets\hero.gif" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
  </ItemGroup>

</Project>
